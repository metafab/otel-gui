{
  "name": "otel-gui",
  "private": true,
  "version": "3.0.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@11.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "node scripts/run-eslint.mjs .",
    "lint:fix": "node scripts/run-eslint.mjs . --fix",
    "format": "prettier --write .",
    "format:changed": "node scripts/prettier-changed.mjs --write",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/prettier-changed.mjs --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "benchmark:contract": "node scripts/benchmark-contract.mjs",
    "sea:bundle": "node scripts/sea-bundle.mjs",
    "sea:package:binary": "node scripts/sea-package.mjs",
    "sea:package:target": "node scripts/sea-package.mjs",
    "sea:package": "pnpm run sea:bundle && pnpm run sea:package:binary"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.8",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "protobufjs": "^8.6.4",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "imports": {
    "#otel-gui/core": "./packages/core/src/index.ts",
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
